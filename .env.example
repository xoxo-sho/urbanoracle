# e-Stat API (人口統計) — https://www.e-stat.go.jp/api/ で無料登録
ESTAT_API_KEY=

# 駅別乗降客数・駅の位置は国土数値情報 S12 の委託スナップショット
# (backend/data/stations.json) から配信する。キーは不要。

# --- バックエンド (FastAPI) ---
# 本番では Secret Manager から注入する。値はリポジトリに置かない。
# DATABASE_URL=
# GIP_PROJECT_ID=dxalabs-platform

# 承認ドメイン制御 (4-layer ルール)。未設定なら freemail 既定リストが有効。
# URBANORACLE_ALLOWLIST_DOMAINS=
# URBANORACLE_FREEMAIL_DOMAINS=
